{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stickier",
  "main": "worker/index.ts",
  // Pinned to the newest date the installed workerd (1.20260515.1) supports.
  // Do not set this ahead of the local runtime or `vite dev` will refuse to boot.
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEiZer9eHCk2A8go"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stickier-db",
      "database_id": "e923c47f-2095-4741-9b5a-76a0f35b9080",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STICKER_ASSETS",
      "bucket_name": "stickier-assets"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "GENERATION_QUEUE",
        "queue": "stickier-generation"
      }
    ],
    "consumers": [
      {
        "queue": "stickier-generation",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 2,
        "dead_letter_queue": "stickier-generation-dlq"
      }
    ]
  },
  "routes": [
    { "pattern": "saltysticker.com", "custom_domain": true },
    { "pattern": "www.saltysticker.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "GENERATE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "DOWNLOAD_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 40, "period": 60 }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
